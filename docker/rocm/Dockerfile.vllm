# AMD ROCm (MI300X / MI355X) vLLM runtime image.
#
# The base is verl's ROCm image (see verl docs/amd_tutorial/amd_quick_start.rst): ROCm torch
# 2.12, vLLM 0.22.1rc1 and verl 0.9.0.dev, Python 3.12. Use it for
# actor_rollout_ref.rollout.name=vllm only; the SGLang build in this image is a newer dev
# build than main's SGLang 0.5.12, so SGLang runs use docker/rocm/Dockerfile.sglang.
#
# Build from the repo root:
#   docker build -f docker/rocm/Dockerfile.vllm -t verl-speco:rocm-vllm .
ARG BASE_IMAGE=amdagi/verl-dev:rocm7.14_torch2.12_release_0724@sha256:919a8a9b462b3e637e3e50bd704b4d987846619ddb35e10b4f15643db179f0e6
FROM ${BASE_IMAGE}

COPY . /workspace/verl-SpeCo
WORKDIR /workspace/verl-SpeCo
# --no-deps keeps the base image's ROCm torch / vllm / verl untouched.
RUN pip install --no-cache-dir --no-deps -e . \
    && python -c "import torch, verl, verl_speco; \
assert torch.version.hip, 'expected a ROCm torch build'; \
print('torch', torch.__version__, 'hip', torch.version.hip); \
print('verl', verl.__version__, verl.__file__); \
print('verl_speco', verl_speco.__version__)"

CMD ["/bin/bash"]
