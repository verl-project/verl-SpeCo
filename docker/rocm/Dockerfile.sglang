# AMD ROCm (MI355X) SGLang runtime image.
#
# Same SGLang release as main's GPU image (verlai/verl:sgl0512.dev1): the official SGLang
# v0.5.12 ROCm image (SGLang tag v0.5.12, commit 127b9e3; torch 2.9.1+rocm7.2.0; Python 3.10).
# Use the -mi30x variant of the same release for MI300X.
#
# Build from the repo root:
#   docker build -f docker/rocm/Dockerfile.sglang -t verl-speco:rocm-sglang .
ARG BASE_IMAGE=lmsysorg/sglang:v0.5.12-rocm720-mi35x@sha256:3be1556105cdfdede103dc053f002d4d0307bdb229d0e15bfef130d5c53af208
FROM ${BASE_IMAGE}

ARG VERL_REF=release/v0.9.0
ARG VERL_REPO=https://github.com/verl-project/verl.git

WORKDIR /workspace

# Mirror main's GPU SGLang image: the extra packages verlai/verl:sgl0512 adds on top of
# lmsysorg/sglang:v0.5.12, then verl at the same ref as docker/verl0.9.0/Dockerfile.sglang.
# Keep the base image's ROCm torch, triton and SGLang; transformers is left to verl's
# requirement (verl 0.9.0 excludes 5.6.0, the version the SGLang base ships), as on GPU.
# ray is pinned to the version in verl's ROCm image: Ray 2.57+ drives AMD GPUs only through
# HIP_VISIBLE_DEVICES and ignores CUDA_VISIBLE_DEVICES, which breaks verl's worker mask check
# when GPUs are selected with CUDA_VISIBLE_DEVICES (see docs/amd/get_started.md).
ARG RAY_VERSION=2.56.1
RUN python -c "import importlib.metadata as md; \
[print(f'{p}=={md.version(p)}') for p in ('torch', 'torchvision', 'torchaudio', 'triton', \
'pytorch-triton-rocm', 'sglang') \
if any(d.metadata['Name'].lower() == p for d in md.distributions())]" \
        > /tmp/rocm-base-constraints.txt \
    && echo "ray==${RAY_VERSION}" >> /tmp/rocm-base-constraints.txt \
    && cat /tmp/rocm-base-constraints.txt \
    && git clone ${VERL_REPO} /workspace/verl \
    && cd /workspace/verl \
    && git checkout ${VERL_REF} \
    && pip install -c /tmp/rocm-base-constraints.txt codetiming mathruler pylatexenc cachetools pytest-asyncio \
    && pip install -c /tmp/rocm-base-constraints.txt -e .

# The FSDP actor loads the model with attn_implementation=flash_attention_2. The GPU image
# installs flash_attn 2.8.3; build the same release here with its ROCm (composable_kernel)
# backend, as verl's ROCm image does. Building for both MI300X and MI355X takes a while.
ARG FLASH_ATTN_REF=v2.8.3
ARG FLASH_ATTN_GPU_ARCHS="gfx942;gfx950"
ARG MAX_JOBS=64
RUN git clone --depth 1 -b ${FLASH_ATTN_REF} https://github.com/Dao-AILab/flash-attention.git /tmp/flash-attention \
    && cd /tmp/flash-attention \
    && git submodule update --init --depth 1 csrc/composable_kernel \
    && GPU_ARCHS="${FLASH_ATTN_GPU_ARCHS}" MAX_JOBS=${MAX_JOBS} \
        pip install --no-build-isolation -c /tmp/rocm-base-constraints.txt . \
    && cd / && rm -rf /tmp/flash-attention

# verl starts SGLang with memory saving (sleep/wake between rollout and training), which
# needs torch_memory_saver. The SGLang ROCm image does not ship it and the PyPI wheel is
# CUDA-only, so build it from source against HIP (same commit as verl's ROCm image).
ARG TORCH_MEMORY_SAVER_REF=39093d62ba84016b25476e321d50ef185e16249d
RUN pip install --no-build-isolation -c /tmp/rocm-base-constraints.txt \
        "git+https://github.com/fzyzcjy/torch_memory_saver.git@${TORCH_MEMORY_SAVER_REF}"

COPY . /workspace/verl-SpeCo

WORKDIR /workspace/verl-SpeCo
RUN pip install -c /tmp/rocm-base-constraints.txt -e . \
    && python -c "import importlib.metadata as md, torch, verl, verl_speco; \
assert torch.version.hip, 'expected a ROCm torch build'; \
print('torch', torch.__version__, 'hip', torch.version.hip); \
print('sglang', md.version('sglang'), 'transformers', md.version('transformers')); \
print('verl', verl.__version__, verl.__file__, 'ray', md.version('ray')); \
print('verl_speco', verl_speco.__version__)" \
    && python -c "import flash_attn, torch_memory_saver, verl.trainer.main_ppo, verl_speco.main; print('flash_attn', flash_attn.__version__)"

CMD ["/bin/bash"]
